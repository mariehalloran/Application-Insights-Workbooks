                  "useGrouping": true,
                  "maximumFractionDigits": 0
                }
              }
            }
          ],
          "rowLimit": 10000,
          "filter": true
        }
      },
      "customWidth": "100",
      "name": "Entity count table",
      "styleSettings": {
        "showBorder": true
      },
      "conditionalVisibilities": [
        {
          "parameterName": "HealthModelLimitExceeded",
